{
  "name": "force-studio-v2",
  "version": "2.0.0",
  "type": "module",
  "description": "Force Studio v2's UI with YuE2 through ComfyUI: text-to-music and music covers, one EXE",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:audio": "node audio-tests.mjs",
    "check": "node --experimental-vm-modules scripts/check.mjs",
    "build:portable": "node scripts/make-portable.mjs",
    "build:exe": "node scripts/make-single-exe.mjs",
    "build:linux": "node scripts/make-linux.mjs",
    "format": "npx --yes prettier@3 --write \"*.mjs\" \"public/*.mjs\" \"public/*.js\" \"public/*.css\" \"test/*.mjs\""
  }
}
